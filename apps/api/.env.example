# --- Servidor ---
NODE_ENV=development
PORT=4000
# URL pública de la web (CORS y enlaces en correos)
APP_URL=http://localhost:5173
# Zona horaria del negocio (qué es "hoy" para vigencias)
APP_TIMEZONE=America/Mexico_City

# --- Base de datos (MySQL 8 en otra máquina, ver D-008) ---
# MySQL 8 local sin SSL: si aparece "RSA public key is not available", agregar ?allowPublicKeyRetrieval=true
DATABASE_URL=mysql://usuario:password@HOST:3306/platinum_intranet

# --- Autenticación ---
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
PASSWORD_RESET_EXPIRES_MIN=30
# Bloqueo de cuenta tras N intentos fallidos de login, durante M minutos
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15
# Intentos de login por IP cada 15 min (subirlo solo en desarrollo/pruebas)
LOGIN_RATE_LIMIT=30

# --- Correo (SMTP) ---
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Platinum Agency <no-reply@platinum.example>"

# --- Archivos / evidencias ---
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Seed inicial (solo para `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@platinum.local
SEED_ADMIN_PASSWORD=
