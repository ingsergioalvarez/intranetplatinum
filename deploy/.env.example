# Copiar a deploy/.env en el servidor y llenar. Ese archivo NO se sube a git.
# Contraseñas y secretos: generarlos con `openssl rand -hex 24` (solo letras y números, sin símbolos).

# --- Base de datos (contenedor mysql, no se abre al exterior) ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# --- Autenticación (distintos entre sí; mínimo 32 caracteres) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Dirección pública de Platinum ---
APP_URL=https://platinum.grupocomunicalo.mx

# --- Primer usuario administrador (solo para `db:seed`) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Correo (SMTP): se llena cuando se tenga ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Platinum Agency <no-reply@grupocomunicalo.mx>

# --- Túnel: archivo de credenciales y usuario del servidor (`id -u` / `id -g`) ---
CLOUDFLARED_CREDENTIALS=/home/sergio/.cloudflared/fe51bf90-21ae-4768-9202-250300febaf3.json
PLATINUM_UID=1000
PLATINUM_GID=1000
