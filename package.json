{
  "name": "platinum-intranet",
  "version": "0.1.0",
  "private": true,
  "description": "Intranet Platinum Agency — monorepo (api, web, shared)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @platinum/api\" \"npm run dev -w @platinum/web\"",
    "dev:api": "npm run dev -w @platinum/api",
    "dev:web": "npm run dev -w @platinum/web",
    "build": "npm run build -w @platinum/shared && npm run build -w @platinum/api && npm run build -w @platinum/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1"
  },
  "type": "module"
}
